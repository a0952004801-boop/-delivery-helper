/* =========================
   分析
========================= */

function renderAnalysis(){

let p=
currentPeriod();

let os=
tripOrders(
periodTrips(p)
);

let byHour={};
let byStart={};
let byEnd={};
let byRoute={};
let byCombo={};

os.forEach(o=>{

let hr=
hourLabel(o.startedAt);

let sa=
o.startArea||
"未標註";

let ea=
o.endArea||
"未標註";

let route=
sa+" → "+ea;

let combo=
hr+"｜"+sa;

byHour[hr]=
(byHour[hr]||0)+1;

byStart[sa]=
(byStart[sa]||0)+1;

byEnd[ea]=
(byEnd[ea]||0)+1;

byRoute[route]=
(byRoute[route]||0)+1;

byCombo[combo]=
(byCombo[combo]||0)+1;

});

function top(obj,n=10){

return Object.entries(obj)
.sort(
(a,b)=>b[1]-a[1]
)
.slice(0,n);

}

function block(title,obj){

let a=top(obj);

return `

<div class="rank">

<b>${title}</b>

${
a.length
?
a.map(
(x,i)=>
`
<div style="margin-top:6px">
${i+1}. ${x[0]}：
<b>${x[1]}單</b>
</div>
`
).join("")
:
'<div class="muted">尚無資料</div>'
}

</div>

`;

}

let ids=
data.idles.filter(
x=>
x.startedAt>=p.start &&
x.startedAt<p.end
);

let idleMap={};

ids.forEach(x=>{

let k=
hourLabel(x.startedAt)+
"｜"+
x.area;

idleMap[k]=
(idleMap[k]||0)+
(x.endedAt-x.startedAt)/60000;

});

let idleTop=
Object.entries(idleMap)
.sort(
(a,b)=>b[1]-a[1]
)
.slice(0,10);

el("analysis")
.innerHTML=

block(
"本期單量最多時段",
byHour
)+

block(
"本期起點最多地區",
byStart
)+

block(
"本期終點最多地區",
byEnd
)+

block(
"地區 × 時段",
byCombo
)+

block(
"起點 → 終點路線",
byRoute
)+

`

<div class="rank">

<b>待機／無單較久</b>

${
idleTop.length
?
idleTop.map(
(x,i)=>

`
<div style="margin-top:6px">
${i+1}.
${x[0]}：
${x[1].toFixed(0)}
分鐘
</div>
`

).join("")
:
'<div class="muted">尚無待機資料</div>'
}

</div>

`;

}

/* =========================
   歷期
========================= */

function renderPeriods(){

if(!data.trips.length){

el("periodList")
.innerHTML=
'<div class="muted">尚無歷期資料</div>';

return;

}

let map={};

data.trips
.forEach(t=>{

let p=
periodFor(t.startedAt);

if(!map[p.key])

map[p.key]={
p,
trips:[]
};

map[p.key]
.trips
.push(t);

});

el("periodList")
.innerHTML=

Object.values(map)
.sort(
(a,b)=>
b.p.start-a.p.start
)
.map(x=>{

let z=
totals(x.trips);

return `

<div class="trip">

<b>
${periodName(x.p)}
</b>

<div class="smallline">

${z.orders}單
｜
接單 ${money(z.income)}
｜
4.1估算 ${money(z.estimate)}
｜
<b>
估算差額 ${money(z.diff)}
</b>

</div>

</div>

`;

}).join("");

}

/* =========================
   全部重畫
========================= */

function renderAll(){

renderOrderStructure();

renderNumbers();

renderRecords();

renderAnalysis();

renderPeriods();

}

function showPanel(name){

[
"records",
"analysis",
"periods"
]
.forEach(n=>

el(n+"Panel")
.classList.toggle(
"hidden",
n!==name
)

);

}

/* =========================
   CSV
========================= */

function exportCSV(){

let rows=[[
"日期",
"趟開始",
"趟結束",
"訂單",
"接單時間",
"完成時間",
"起點",
"終點",
"接單金額",
"分鐘",
"4.1估算",
"估算差額",
"趟里程",
"期別"
]];

data.trips
.forEach(t=>

(t.orders||[])
.forEach(o=>{

let p=
periodFor(o.startedAt);

rows.push([

localDate(o.startedAt),

clock(t.startedAt),

clock(t.endedAt),

o.id,

clock(o.startedAt),

clock(o.endedAt),

o.startArea||"",

o.endArea||"",

o.amount,

mins(
o,
o.endedAt
).toFixed(2),

est(
o,
o.endedAt
).toFixed(2),

diff(
o,
o.endedAt
).toFixed(2),

Number(
t.km||0
).toFixed(2),

periodName(p)

]);

})

);

let csv=
"\ufeff"+
rows.map(
r=>
r.map(
v=>
`"${String(v)
.replaceAll('"','""')}"`
)
.join(",")
)
.join("\n");

let a=
document.createElement("a");

a.href=
URL.createObjectURL(
new Blob(
[csv],
{
type:
"text/csv;charset=utf-8"
}
)
);

a.download=
"外送助手_v052_"+
localDate()+
".csv";

a.click();

setTimeout(
()=>URL.revokeObjectURL(a.href),
1000
);

}

/* =========================
   清除今日
========================= */

function clearToday(){

if(!confirm(
"確定清除今天已完成的外送與待機資料？\n\n正式使用後除非確定是測試資料，否則不建議使用。"
))
return;

let td=
localDate();

data.trips=
data.trips.filter(
t=>
localDate(t.startedAt)!==td
);

data.idles=
data.idles.filter(
x=>
localDate(x.startedAt)!==td
);

save();

renderAll();

}

