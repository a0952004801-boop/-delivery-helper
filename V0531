</div>

<!-- 今日統計 -->

<div class="grid">

<div class="stat">
<small>今日趟次</small>
<b id="sTrips">0</b>
</div>

<div class="stat">
<small>今日訂單</small>
<b id="sOrders">0</b>
</div>

<div class="stat">
<small>今日接單金額</small>
<b id="sIncome">$0</b>
</div>

<div class="stat">
<small>今日估算差額</small>
<b id="sDiff">$0</b>
</div>

<div class="stat">
<small>今日里程</small>
<b id="sKm">0.00 km</b>
</div>

<div class="stat">
<small>目前期別訂單</small>
<b id="sPeriodOrders">0</b>
</div>

</div>

<!-- 期別 -->

<div class="card">

<b>目前期別</b>

<div id="periodText"
     class="muted"
     style="margin-top:7px">
</div>

<div class="grid" style="margin-top:10px">

<div class="stat">
<small>本期接單金額</small>
<b id="pIncome">$0</b>
</div>

<div class="stat">
<small>本期4.1估算</small>
<b id="pEstimate">$0</b>
</div>

<div class="stat">
<small>本期估算差額</small>
<b id="pDiff">$0</b>
</div>

<div class="stat">
<small>本期訂單</small>
<b id="pOrders">0</b>
</div>

</div>

</div>

<!-- 跑單 -->

<div class="card" id="activeCard">

<div class="muted">本趟總時間</div>

<div class="timer" id="timer">
00:00:00
</div>

<div class="muted" id="gpsStatus">
GPS 尚未啟動
</div>

<label>GPS里程（參考）</label>

<input id="liveKm"
       value="0.00 km"
