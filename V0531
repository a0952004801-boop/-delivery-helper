<style>
*{box-sizing:border-box}
body{
  margin:0;
  background:#0b0f14;
  color:#fff;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif
}
.wrap{max-width:760px;margin:auto;padding:16px}
h1{font-size:29px;margin:6px 0}
.sub,.muted{color:#94a3b8;font-size:13px}
.card{
  background:#111827;
  border:1px solid #263244;
  border-radius:18px;
  padding:15px;
  margin:12px 0
}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}
.stat{background:#0f172a;border-radius:13px;padding:11px}
.stat small{color:#94a3b8}
.stat b{display:block;font-size:20px;margin-top:4px}
.timer{
  text-align:center;
  font-size:38px;
  font-weight:800;
  font-variant-numeric:tabular-nums;
  margin:8px
}
label{
  display:block;
  color:#cbd5e1;
  font-size:13px;
  margin:8px 0 5px
}
input,select{
  width:100%;
  padding:12px;
  border-radius:11px;
  border:1px solid #334155;
  background:#0b1220;
  color:#fff;
  font-size:16px
}
button{
  width:100%;
  padding:14px;
  border:0;
  border-radius:14px;
  font-size:16px;
  font-weight:800;
  margin-top:8px
}
.start{background:#22c55e;color:#06240f}
.finish{background:#ef4444;color:#fff}
.add{background:#2563eb;color:#fff}
.secondary{background:#1f2937;color:#fff}
.orange{background:#f59e0b;color:#1c1202}
.buttons{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:9px
}
.order,.trip,.rank{
  background:#0f172a;
  border:1px solid #334155;
  border-radius:13px;
  padding:11px;
  margin-top:9px;
  font-size:14px
}
.order.done{opacity:.8}
.orderhead{
  display:flex;
  justify-content:space-between;
  gap:8px
}
.warning{
  color:#fbbf24;
  font-size:12px;
  line-height:1.5
}
.tabs{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:6px
}
.tabs button{font-size:13px;padding:10px}
.hidden{display:none}
.route{margin-top:5px;font-weight:700}
.smallline{color:#cbd5e1;font-size:13px;margin-top:4px}
.area-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:7px;
  margin-top:6px
}
.area-btn{
  background:#1f2937;
  color:#fff;
  padding:11px 6px;
  font-size:14px;
  margin:0
}
.area-btn.selected{
  background:#22c55e;
  color:#06240f
}
.editbox{
  border-top:1px solid #334155;
  margin-top:10px;
  padding-top:10px
}
.badge{
  display:inline-block;
  background:#1e293b;
  padding:4px 8px;
  border-radius:20px;
  font-size:12px;
  margin-top:5px
}
@media(max-width:420px){
  .area-grid{grid-template-columns:repeat(2,1fr)}
}
</style>
</head>

<body>

<div class="wrap">

<h1>
外送助手
<span class="muted">v0.5.2 修正版</span>
</h1>

<div class="sub">
iPhone 跑單・Windows 查看・Supabase 同步・最多10張疊單・可修改與刪除誤按
</div>

<!-- 雲端 -->
<div class="card">

<b>雲端同步</b>

<div id="authStatus" class="muted" style="margin-top:7px">
尚未登入
