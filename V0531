<script>

/* =========================
   基本設定
========================= */

const SUPABASE_URL =
"https://gmoquieiegopatzpvooc.supabase.co";

const SUPABASE_KEY =
"sb_publishable_q--fgZi5lR2LqSYIFyqyVw_70NeU_ki";

const sb =
window.supabase.createClient(
SUPABASE_URL,
SUPABASE_KEY
);

const KEY="delivery-helper-v052";

const OLDKEYS=[
"delivery-helper-v05",
"delivery-helper-v04",
"delivery-helper-v03-final",
"delivery-helper-v03"
];

const RATE=4.1;

const MAX_ORDERS=10;

const AREAS=[
"北區",
"中西區",
"東區",
"永康區",
"安南區",
"安平區",
"南區",
"仁德區",
"歸仁區",
"新市區",
"善化區",
"安定區",
"其他"
];

let session=null;
let cloudRowId=null;
let syncTimer=null;
let syncBusy=false;

let data=loadData();

let gpsWatch=null;
let lastPos=null;

let firstStart="北區";
let nextStart="北區";
let idleArea="北區";

let lastOrderStructure="";

/* =========================
   資料
========================= */

function blank(){

return {
active:null,
trips:[],
idle:null,
idles:[],
_updatedAt:0
};

}

function loadData(){

try{

let own=
localStorage.getItem(KEY);

if(own)
return Object.assign(
blank(),
JSON.parse(own)
);

for(const k of OLDKEYS){

let old=
localStorage.getItem(k);

if(old){

let d=
Object.assign(
blank(),
JSON.parse(old)
);

d._updatedAt=Date.now();

localStorage.setItem(
KEY,
JSON.stringify(d)
);

return d;

}

}

}catch(e){
console.error(e);
}

return blank();

}

function save(localChange=true){

if(localChange)
data._updatedAt=Date.now();

localStorage.setItem(
KEY,
JSON.stringify(data)
);

if(localChange)
scheduleSync();

}

/* =========================
   工具
========================= */

function el(id){
return document.getElementById(id);
}

function money(n){
return "$"+
Number(n||0).toFixed(1);
}

function localDate(ms=Date.now()){

let d=new Date(ms);

return d.getFullYear()+"-"+
String(d.getMonth()+1).padStart(2,"0")+"-"+
String(d.getDate()).padStart(2,"0");

}

function clock(ms){

if(!ms)return "--:--:--";

let d=new Date(ms);

return String(d.getHours()).padStart(2,"0")+":"+
String(d.getMinutes()).padStart(2,"0")+":"+
String(d.getSeconds()).padStart(2,"0");

}

function dur(ms){

let s=
Math.max(
0,
Math.floor(ms/1000)
);

let h=Math.floor(s/3600);

let m=
Math.floor(
(s%3600)/60
);

let q=s%60;

return [h,m,q]
.map(v=>
String(v).padStart(2,"0")
)
.join(":");

}

function mins(o,now=Date.now()){

return Math.max(
0,
((o.endedAt||now)-o.startedAt)/60000
);

}

function est(o,now=Date.now()){

return mins(o,now)*RATE;

}

function diff(o,now=Date.now()){

return Math.max(
0,
est(o,now)-
Number(o.amount||0)
);

}

function hourLabel(ms){

let h=
new Date(ms).getHours();

return String(h).padStart(2,"0")+
":00–"+
String(h).padStart(2,"0")+
":59";

}

/* =========================
   期別
========================= */

function periodFor(ms){

let anchor=
new Date(
2026,7,31,4,0,0,0
).getTime();

let span=
14*86400000;

let i=
Math.floor(
(ms-anchor)/span
);

let start=
anchor+i*span;

let end=
start+span;

return {
start,
end,
key:localDate(start)+"_04"
};

}

function periodName(p){

return localDate(p.start)+
" 04:00 ～ "+
localDate(p.end)+
" 03:59";

}

function currentPeriod(){

return periodFor(Date.now());

}

/* =========================
   Supabase
========================= */

function setSyncStatus(t){

el("syncStatus").textContent=t;

}

function scheduleSync(){

if(!session)return;

clearTimeout(syncTimer);

syncTimer=
setTimeout(
()=>syncNow(false),
1200
);

}

async function syncNow(manual=true){

if(!session||syncBusy)return;

syncBusy=true;

try{

setSyncStatus("正在同步…");

const {data:rows,error}=
await sb
.from("delivery_data")
.select("id,data,updated_at")
.eq("data_type","snapshot")
.order("updated_at",
{ascending:false})
.limit(1);

if(error)throw error;

if(!rows||
rows.length===0){

const {data:ins,error:ie}=
await sb
.from("delivery_data")
.insert({
user_id:session.user.id,
device_id:
navigator.userAgent.slice(0,120),
data_type:"snapshot",
data:data
})
.select("id")
.single();

if(ie)throw ie;

cloudRowId=ins.id;

setSyncStatus(
"已建立雲端資料並同步"
);

}else{

cloudRowId=
rows[0].id;

const cloud=
Object.assign(
blank(),
rows[0].data||{}
);

const lu=
Number(
data._updatedAt||0
);

const cu=
Number(
cloud._updatedAt||0
);

if(cu>lu){

data=cloud;

save(false);

lastOrderStructure="";

renderAll();

setSyncStatus(
"已從雲端下載最新資料"
);

}else if(lu>cu){

const {error:ue}=
await sb
.from("delivery_data")
.update({
data:data,
device_id:
navigator.userAgent.slice(0,120),
updated_at:
new Date().toISOString()
})
.eq("id",cloudRowId);

if(ue)throw ue;

setSyncStatus(
"已上傳最新資料到雲端"
);

}else{

setSyncStatus(
"雲端與本機已同步"
);

}

}

}catch(err){

console.error(err);

setSyncStatus(
"同步失敗："+
(err.message||String(err))
);

if(manual)
alert(
"同步失敗\n"+
(err.message||String(err))
);

}finally{

syncBusy=false;

}

}

function renderAuth(){

if(session){

el("loginBox")
.classList.add("hidden");

el("loggedBox")
.classList.remove("hidden");

el("authStatus")
.textContent=
"已登入："+
(session.user.email||"");

}else{

el("loginBox")
.classList.remove("hidden");

el("loggedBox")
.classList.add("hidden");

el("authStatus")
.textContent="尚未登入";

setSyncStatus(
"本機資料可離線使用"
);

}

}

async function refreshSession(){

const {data:r}=
await sb.auth.getSession();

session=r.session;

renderAuth();

if(session)
await syncNow(false);

}

async function login(){

const email=
el("email").value.trim();

const password=
el("password").value;

if(!email||!password)
return alert(
"請輸入 Email 和密碼"
);

const {data:r,error}=
await sb.auth.signInWithPassword({
email,
password
});

if(error)
return alert(
"登入失敗\n"+
error.message
);

session=r.session;

renderAuth();

await syncNow(true);

}

async function signup(){

const email=
el("email").value.trim();

const password=
el("password").value;

if(!email||
password.length<6)
return alert(
"請輸入 Email，密碼至少 6 個字元"
);

const {data:r,error}=
await sb.auth.signUp({
email,
password
});

if(error)
return alert(
"註冊失敗\n"+
error.message
);

session=r.session;

if(!session){

alert(
"註冊完成，請驗證 Email 後再登入。"
);

}else{

alert("註冊成功");

renderAuth();

await syncNow(true);

}

}

async function logout(){

await sb.auth.signOut();

session=null;
cloudRowId=null;

renderAuth();

}

/* =========================
   區域按鈕
========================= */

function makeAreaButtons(
containerId,
getSelected,
setSelected
){

let c=el(containerId);

c.innerHTML=
AREAS.map(a=>

`<button
type="button"
class="area-btn ${
getSelected()===a
?"selected":""
}"
data-area="${a}">
${a}
</button>`

).join("");

c.querySelectorAll(
".area-btn"
).forEach(btn=>{

btn.onclick=()=>{

setSelected(
btn.dataset.area
);

c.querySelectorAll(
".area-btn"
).forEach(b=>

b.classList.toggle(
"selected",
b===btn
)

);

};

});

}

function initAreaButtons(){

makeAreaButtons(
"firstStartArea",
()=>firstStart,
v=>firstStart=v
);

makeAreaButtons(
"nextStartArea",
()=>nextStart,
v=>nextStart=v
);

makeAreaButtons(
"idleAreaButtons",
()=>idleArea,
v=>idleArea=v
);

}

initAreaButtons();

/* =========================
   GPS
========================= */

function distance(a,b){

const R=6371;

const r=x=>
x*Math.PI/180;

const dLat=
r(b.lat-a.lat);

const dLon=
r(b.lon-a.lon);

const x=
Math.sin(dLat/2)**2+
Math.cos(r(a.lat))*
Math.cos(r(b.lat))*
Math.sin(dLon/2)**2;

return 2*R*
Math.asin(
Math.sqrt(x)
);

}

function startGPS(){

if(!navigator.geolocation){

el("gpsStatus")
.textContent=
"此裝置不支援GPS";

return;

}

if(gpsWatch!==null)
navigator.geolocation
.clearWatch(gpsWatch);

gpsWatch=
navigator.geolocation
.watchPosition(

p=>{

el("gpsStatus")
.textContent=
"GPS 已啟動，精度約 "+
Math.round(
p.coords.accuracy
)+" 公尺";

if(!data.active||
p.coords.accuracy>80)
return;

let cur={
lat:p.coords.latitude,
lon:p.coords.longitude
};

if(lastPos){

let km=
distance(lastPos,cur);

if(km<1.5){

data.active.km=
(data.active.km||0)+km;

save();

}

}

lastPos=cur;

renderNumbers();

},

()=>{

el("gpsStatus")
.textContent=
"GPS 無法使用，請檢查位置權限";

},

{
enableHighAccuracy:true,
maximumAge:5000,
timeout:15000
}

);

}

function stopGPS(){

if(gpsWatch!==null)
navigator.geolocation
.clearWatch(gpsWatch);

gpsWatch=null;
lastPos=null;

}

/* =========================
   待機
========================= */

function stopIdle(renderNow=true){

if(!data.idle)return;

data.idles.push({
...data.idle,
endedAt:Date.now()
});

data.idle=null;

save();

if(renderNow)
renderAll();

}

function startIdle(){

if(data.active)
return alert(
"目前有進行中的訂單"
);

if(data.idle)
return alert(
"待機已經開始"
);

data.idle={
area:idleArea,
startedAt:Date.now()
};

save();
renderAll();

}

/* =========================
   開始第一張
========================= */

function startTrip(){

let amount=
Number(
el("firstAmount").value
);

if(!(amount>0))
return alert(
"請輸入第1張接單金額"
);

stopIdle(false);

let now=Date.now();

data.active={
startedAt:now,
km:0,
orders:[
{
id:1,
startedAt:now,
endedAt:null,
amount,
startArea:firstStart,
endArea:""
}
]
};

el("firstAmount").value="";
el("manualKm").value="";

save();

startGPS();

lastOrderStructure="";

renderAll();

}

/* =========================
   加入疊單
========================= */

function addOrder(){

if(!data.active)
return;

if(
data.active.orders.length
>=MAX_ORDERS
)
return alert(
"最多可記錄10張疊單"
);

let amount=
Number(
el("nextAmount").value
);

if(!(amount>0))
return alert(
"請輸入這張疊單金額"
);

let id=
data.active.orders.length+1;

data.active.orders.push({

id,
startedAt:Date.now(),
endedAt:null,
amount,
startArea:nextStart,
endArea:""

});

el("nextAmount").value="";

save();

lastOrderStructure="";

renderAll();

}

/* =========================
   選終點
========================= */

function selectEndArea(
id,
area
){

let o=
data.active?.orders
.find(x=>x.id===id);

if(!o||
o.endedAt)
return;

o.tempEndArea=area;

save();

let box=
el("endButtons"+id);

if(box){

box.querySelectorAll(
".area-btn"
).forEach(b=>

b.classList.toggle(
"selected",
b.dataset.area===area
)

);

}

}

/* =========================
   完成訂單
========================= */

function finishOrder(id){

let o=
data.active?.orders
.find(x=>x.id===id);

if(!o||
o.endedAt)
return;

if(!o.tempEndArea)
return alert(
"請先選擇終點區域"
);

o.endArea=
o.tempEndArea;

o.endedAt=
Date.now();

delete o.tempEndArea;

save();

lastOrderStructure="";

renderAll();

}

/* =========================
   取消進行中訂單
========================= */

function cancelActiveOrder(id){

let o=
data.active?.orders
.find(x=>x.id===id);

if(!o||
o.endedAt)
return;

if(!confirm(
"確定取消這張訂單？\n取消後不列入正式單量與收入。"
))
return;

data.active.orders=
data.active.orders
.filter(x=>x.id!==id);

data.active.orders
.forEach(
(x,i)=>x.id=i+1
);

if(
data.active.orders.length===0
){

data.active=null;

stopGPS();

}

save();

lastOrderStructure="";

renderAll();

}

/* =========================
   結束本趟
========================= */

function closeTrip(){

if(!data.active)
return;

if(
data.active.orders
.some(o=>!o.endedAt)
)
return alert(
"還有訂單尚未完成"
);

let manual=
Number(
el("manualKm").value
);

let a=data.active;

data.trips.push({

...a,

endedAt:Date.now(),

km:
manual>0
?manual
:(a.km||0)

});

data.active=null;

el("manualKm").value="";

save();

stopGPS();

lastOrderStructure="";

renderAll();

}

/* =========================
   修改完成紀錄
========================= */

function editFinishedOrder(
tripStart,
orderId
){

let t=
data.trips.find(
x=>x.startedAt===tripStart
);

if(!t)return;

let o=
(t.orders||[])
.find(
x=>x.id===orderId
);

if(!o)return;

let amount=
prompt(
"修改接單金額",
o.amount
);

if(amount===null)
return;

amount=
Number(amount);

if(!(amount>0))
return alert(
"金額必須大於 0"
);

/* 起點 */

let start=
prompt(
"修改起點區域\n可輸入："+AREAS.join("、"),
o.startArea||""
);

if(start===null)
return;

start=start.trim();

if(!AREAS.includes(start))
return alert(
"起點區域名稱不正確"
);

/* 終點 */

let end=
prompt(
"修改終點區域\n可輸入："+AREAS.join("、"),
o.endArea||""
);

if(end===null)
return;

end=end.trim();

if(!AREAS.includes(end))
return alert(
"終點區域名稱不正確"
);

o.amount=amount;
o.startArea=start;
o.endArea=end;

save();

renderAll();

}

/* =========================
   刪除誤按訂單
========================= */

function deleteFinishedOrder(
tripStart,
orderId
){

let t=
data.trips.find(
x=>x.startedAt===tripStart
);

if(!t)return;

let o=
(t.orders||[])
.find(
x=>x.id===orderId
);

if(!o)return;

if(!confirm(
"確定刪除這張訂單？\n\n"+
"第"+o.id+"張\n"+
(o.startArea||"?")+" → "+
(o.endArea||"?")+"\n"+
"金額："+money(o.amount)+
"\n\n刪除後無法復原。"
))
return;

t.orders=
t.orders.filter(
x=>x.id!==orderId
);

t.orders.forEach(
(x,i)=>x.id=i+1
);

if(
t.orders.length===0
){

data.trips=
data.trips.filter(
x=>x!==t
);

}

save();

renderAll();

}

/* =========================
   統計
========================= */

function tripOrders(trips){

return trips.flatMap(
t=>t.orders||[]
);

}

function totals(trips){

let os=
tripOrders(trips);

return {

orders:
os.length,

income:
os.reduce(
(s,o)=>
s+Number(o.amount||0),
0
),

estimate:
os.reduce(
(s,o)=>
s+est(
o,
o.endedAt||Date.now()
),
0
),

diff:
os.reduce(
(s,o)=>
s+diff(
o,
o.endedAt||Date.now()
),
0
),

km:
trips.reduce(
(s,t)=>
s+Number(t.km||0),
0
)

};

}

function todayTrips(){

let td=
localDate();

return data.trips
.filter(
t=>
localDate(t.startedAt)===td
);

}

function periodTrips(
p=currentPeriod()
){

return data.trips
.filter(
t=>
t.startedAt>=p.start &&
t.startedAt<p.end
);

}

