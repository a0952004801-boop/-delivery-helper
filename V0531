接單金額：
${money(o.amount)}
</div>

<div class="smallline">
接單：
${clock(o.startedAt)}
${o.endedAt
?"｜完成："+clock(o.endedAt)
:""}
</div>

<div class="smallline">
時間：
<span id="m${o.id}">
${mins(o).toFixed(1)}
</span>
